{
  "prettier": {
    "plugins": ["prettier-plugin-sh"],
    "overrides": [
      {
        "files": ["**/*Dockerfile"],
        "options": {
          "parser": "sh"
        }
      }
    ]
  },
  "remarkConfig": {
    "plugins": [
      "gfm",
      "lint",
      "preset-lint-consistent",
      "preset-lint-markdown-style-guide",
      "preset-lint-recommended",
      "preset-prettier"
    ]
  },
  "scripts": { "lint": ["bin/remark-for-claude.sh"] }
}
